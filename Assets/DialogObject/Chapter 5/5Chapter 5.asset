  dialogueLines:
  - characterName: Alice
    dialogueText: (pelan, hampir bisikan) Tapi aku takut.
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Rian
    dialogueText: Itu hal yang Wajar sih. Yang penting kamu nggak lari terus.
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Rian
    dialogueText: "Ayo. Kita lihat Bu Erika di ruang BK. Kalau beliau masih ada,
      bagus. Kalau nggak\u2026 yabesok."
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Alice
    dialogueText: (kaget ringan) Serius sekarang?
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Rian
    dialogueText: (senyum kecil, santai) Bukannya kamu yang bilang mau nyoba.
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Rian
    dialogueText: Tenang aja. Bu Rika orangnya dengerin dulu baru ngomong. Dia bakalan
      ngerti.
    portraitSprite: {fileID: 0}
    expression: 0
  missionToComplete: 0
