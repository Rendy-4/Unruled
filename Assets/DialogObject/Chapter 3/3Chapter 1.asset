  dialogueLines:
  - characterName: Ayah
    dialogueText: '(suara tinggi dari ruang tamu) Aku

      udah bilang jangan
      ambil keputusan besar tanpa diskusi dulu!'
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Ibu
    dialogueText: (di ruang tamu, emosi tertahan) Diskusi apa? Kamu bahkan tidak
      pernah ada! Yang kamu tahu cuma kerja dan pulang marah!
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Ayah
    dialogueText: Ini tentang masa depan, bukan soal ego kamu!
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Ayah
    dialogueText: '(suara tinggi dari ruang tamu) Aku

      udah bilang jangan
      ambil keputusan besar tanpa diskusi dulu!'
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Ibu
    dialogueText: Masa depan? Dari dulu kamu bicara begitu, tapi lihat apa yang terjadi
      pada keluarga ini!
    portraitSprite: {fileID: 0}
    expression: 0
  missionToComplete: 0
