  - characterName: Alice
    dialogueText: tuk tuk tuk (Mengetuk Pintu Pelan)
    portraitSprite: {fileID: 9049539159198059528, guid: a5b0dcdf2040c7f4387b45e2aaec95cf, type: 3}
    expression: 0
  - characterName: Bu Erika
    dialogueText: Ada keperluan apa?
