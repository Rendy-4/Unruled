  dialogueLines:
  - characterName: Alice
    dialogueText: Kenapa kau mengejarku sampai disini?
    portraitSprite: {fileID: 292776439409623423, guid: 241d72680ce0637f9b29e8367fc90307, type: 3}
    expression: 2
  - characterName: Rian
    dialogueText: Iya. Kenapa juga kau berlari saat ketemu aku?
    portraitSprite: {fileID: 7455303052798692335, guid: ecac9c42e332271aca7c585f10abeae4, type: 3}
    expression: 1
  - characterName: Alice
    dialogueText: "eng\u2026 enggak kok, aku cuman pengen buru-buru aja"
    portraitSprite: {fileID: 7455303052798692335, guid: ecac9c42e332271aca7c585f10abeae4, type: 3}
    expression: 1
  - characterName: Rian
    dialogueText: terus ngapain kamu ke belakang sekolah
    portraitSprite: {fileID: 7455303052798692335, guid: ecac9c42e332271aca7c585f10abeae4, type: 3}
    expression: 1
  - characterName: Alice
    dialogueText: bukan urusanmu sudah pergi sana!
    portraitSprite: {fileID: 7455303052798692335, guid: ecac9c42e332271aca7c585f10abeae4, type: 3}
    expression: 1
