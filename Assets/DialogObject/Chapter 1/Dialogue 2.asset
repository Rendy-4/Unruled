  dialogueLines:
  - characterName: Milo
    dialogueText: Rian, buku PR yang kau janjikan mana?
    portraitSprite: {fileID: -7125492961162913332, guid: ec9bd600b5183e94b855587cd9309dcd, type: 3}
    expression: 0
  - characterName: Rian
    dialogueText: Iya - iya. Nih.
    portraitSprite: {fileID: -2823772571983056389, guid: 5fa7cee959baad64ca70a2e7e73180ac, type: 3}
    expression: 0
  - characterName: Milo
    dialogueText: Pahlawan hidupku.
    portraitSprite: {fileID: -7125492961162913332, guid: ec9bd600b5183e94b855587cd9309dcd, type: 3}
    expression: 0
  - characterName: Rian
    dialogueText: Sudah, jangan lebay.
    portraitSprite: {fileID: -2823772571983056389, guid: 5fa7cee959baad64ca70a2e7e73180ac, type: 3}
    expression: 0
