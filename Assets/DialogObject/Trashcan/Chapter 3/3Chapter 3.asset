  m_Script: {fileID: 11500000, guid: 9f33af7d2d861f54bb5c0a732c77d098, type: 3}
  m_Name: 3Chapter 3
  m_EditorClassIdentifier: 
  dialogueLines:
  - characterName: Ayah
    dialogueText: "(berbisik, tapi terdengar) Kita juga harus bicara soal Alice.
      Dia kelihatan makin\u2026 ya, kamu juga lihat."
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Ibu
    dialogueText: (lebih pelan) Tolong jangan salahkan Alice juga. anak itu sudah
      cukup pusing.
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Ibu
    dialogueText: "(berusaha bersikap normal, canggung) \u201Coh Alice, Kamu sudah
      makan?\u201D"
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Alice
    dialogueText: (datar, tanpa emosi) Belum. Ga lapar.
    portraitSprite: {fileID: 0}
    expression: 0
  - characterName: Ibu
    dialogueText: Masa depan? Dari dulu kamu bicara begitu, tapi lihat apa yang terjadi
      pada keluarga ini!
    portraitSprite: {fileID: 0}
    expression: 0
  missionToComplete: 0
