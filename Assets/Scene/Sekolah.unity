  m_Script: {fileID: 11500000, guid: b25314f6f199958468a16cf0f6634504, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  typeOfDialogue: 0
  dialogueLines:
  - characterName: Milo
    dialogueText: Rian, PR Pak Surya udah kelar belum? Jangan bilang kamu udah ngerjain?
    portraitSprite: {fileID: -5754388876357630561, guid: 5e0b100468a6a5e4cb38c08b5fe4ff50, type: 3}
    expression: 4
  - characterName: Rian
    dialogueText: Kalo muka panik gitu sih, kayaknya kamu belum ya?
    portraitSprite: {fileID: 8832167503239892954, guid: c99811cb531d0064c880fbdbb2878519, type: 3}
    expression: 0
  - characterName: Milo
    dialogueText: Hehe... pinjam catatanmu dong. Darurat ini.
    portraitSprite: {fileID: -5754388876357630561, guid: 5e0b100468a6a5e4cb38c08b5fe4ff50, type: 3}
    expression: 1
  - characterName: Milo
    dialogueText: Hehe... pinjam catatanmu dong. Darurat ini.
    portraitSprite: {fileID: -5754388876357630561, guid: 5e0b100468a6a5e4cb38c08b5fe4ff50, type: 3}
    expression: 1
  - characterName: Rian
    dialogueText: Dih kayak orang minta uang 100rb aja, kau
    portraitSprite: {fileID: 8832167503239892954, guid: c99811cb531d0064c880fbdbb2878519, type: 3}
    expression: 3
  - characterName: Milo
    dialogueText: nanti kubayar 100rb
    portraitSprite: {fileID: -5754388876357630561, guid: 5e0b100468a6a5e4cb38c08b5fe4ff50, type: 3}
    expression: 1
  - characterName: Rian
    dialogueText: Deal! gk nih ?
    portraitSprite: {fileID: 8832167503239892954, guid: c99811cb531d0064c880fbdbb2878519, type: 3}
    expression: 1
  - characterName: Rian
    dialogueText: 'Jangan dong '
    portraitSprite: {fileID: 8832167503239892954, guid: c99811cb531d0064c880fbdbb2878519, type: 3}
    expression: 1
  currentMission: 0
